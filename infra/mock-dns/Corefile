# Deterministic upstream resolver used only by the local Docker demo.
# It prevents benign-path demonstrations from depending on public DNS availability.
.:53 {
    hosts {
        203.0.113.10 isro.gov.in
        203.0.113.11 google.com
        203.0.113.12 github.com
        203.0.113.13 microsoft.com
        203.0.113.14 gooogle.com
        fallthrough
    }
    template IN A {
        match ^.*\.$
        answer "{{ .Name }} 60 IN A 203.0.113.99"
    }
    log
    errors
}

